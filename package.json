:root {
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  color: #f5f6f8;
  background: #08090c;
  font-synthesis: none;
}

* { box-sizing: border-box; }

html { background: #08090c; }

body {
  margin: 0;
  min-width: 320px;
  background:
    radial-gradient(circle at 78% 18%, rgba(220, 65, 50, .13), transparent 30rem),
    #08090c;
}

a { color: inherit; text-decoration: none; }

.app { min-height: 100vh; display: flex; flex-direction: column; }

.header {
  position: sticky;
  top: 0;
  z-index: 20;
  min-height: 76px;
  padding: 0 6vw;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 25px;
  background: rgba(8, 9, 12, .88);
  border-bottom: 1px solid #1d2027;
  backdrop-filter: blur(16px);
}

.logo {
  display: flex;
  align-items: center;
  gap: 10px;
  font-weight: 900;
  letter-spacing: .08em;
  white-space: nowrap;
}

.logo-icon {
  width: 35px;
  height: 35px;
  display: grid;
  place-items: center;
  border-radius: 9px;
  background: #df4c3e;
}

.nav {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 4px;
}

.nav a {
  padding: 10px 12px;
  border-radius: 9px;
  color: #9298a2;
  font-size: 14px;
  transition: .2s;
}

.nav a:hover,
.nav a.active {
  color: #fff;
  background: #17191e;
}

.container {
  width: min(1120px, 88%);
  margin: 0 auto;
}

.home {
  min-height: calc(100vh - 76px);
  display: grid;
  grid-template-columns: 1.08fr .92fr;
  gap: 70px;
  align-items: center;
}

.eyebrow {
  color: #e45b4e;
  font-size: 11px;
  font-weight: 900;
  letter-spacing: .2em;
  margin-bottom: 15px;
}

h1 {
  margin: 0 0 22px;
  font-size: clamp(44px, 7vw, 78px);
  line-height: .95;
  letter-spacing: -.055em;
}

.home h1 span { color: #e45b4e; }

.home-text p {
  max-width: 610px;
  color: #9298a2;
  line-height: 1.75;
}

.buttons {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  margin-top: 30px;
}

.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 46px;
  padding: 0 18px;
  border-radius: 10px;
  font-size: 14px;
  font-weight: 850;
}

.primary { background: #df4c3e; }
.primary:hover { background: #ee5d4e; }

.secondary {
  background: #14161b;
  border: 1px solid #30343c;
}

.home-panel {
  min-height: 370px;
  position: relative;
  overflow: hidden;
  display: grid;
  place-items: center;
  border: 1px solid #292d35;
  border-radius: 26px;
  background: linear-gradient(145deg, #15171d, #0d0f13);
}

.orb {
  position: absolute;
  width: 250px;
  height: 250px;
  border-radius: 50%;
  background: rgba(223, 76, 62, .18);
  filter: blur(45px);
}

.panel-content {
  position: relative;
  text-align: center;
}

.panel-content small {
  display: block;
  color: #747a84;
  letter-spacing: .2em;
  font-size: 10px;
}

.panel-content strong {
  display: block;
  margin: 9px 0;
  font-size: 48px;
}

.panel-content span { color: #8c929d; }

.page {
  min-height: calc(100vh - 150px);
  padding: 70px 0;
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 30px;
  margin-bottom: 40px;
}

.section-head h1 { font-size: 56px; margin: 0; }

.section-head p {
  max-width: 400px;
  color: #8e949e;
  line-height: 1.6;
}

.hero-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16px;
}

.hero-card {
  display: flex;
  align-items: center;
  gap: 18px;
  padding: 22px;
  border: 1px solid #272b33;
  border-radius: 17px;
  background: #111318;
  transition: transform .2s, border-color .2s;
}

.hero-card:hover {
  transform: translateY(-3px);
  border-color: #555b66;
}

.hero-icon,
.detail-icon {
  display: grid;
  place-items: center;
  flex: 0 0 auto;
  border-radius: 14px;
  background: #252a33;
  font-weight: 900;
}

.hero-icon {
  width: 62px;
  height: 62px;
  font-size: 25px;
}

.hero-info h2 {
  margin: 0 0 5px;
  font-size: 19px;
}

.hero-info span { color: #858b96; }

.hero-card b {
  margin-left: auto;
  color: #727984;
  font-size: 20px;
}

.violet { --accent: #9c63d8; }
.red { --accent: #df5b50; }
.green { --accent: #63a274; }
.blue { --accent: #629bc9; }

.hero-icon.violet, .violet .detail-icon { background: #4b3260; }
.hero-icon.red, .red .detail-icon { background: #63312e; }
.hero-icon.green, .green .detail-icon { background: #31523c; }
.hero-icon.blue, .blue .detail-icon { background: #304d65; }

.back {
  display: inline-block;
  margin-bottom: 20px;
  color: #aeb4be;
}

.hero-detail {
  display: flex;
  align-items: center;
  gap: 32px;
  padding: 45px;
  border: 1px solid #292d35;
  border-radius: 24px;
  background: #111318;
}

.detail-icon {
  width: 135px;
  height: 135px;
  font-size: 56px;
}

.hero-detail h1 {
  font-size: 58px;
  margin-bottom: 8px;
}

.role {
  color: var(--accent);
  font-weight: 800;
  margin-bottom: 20px;
}

.hero-detail p {
  color: #a1a6af;
  line-height: 1.7;
  max-width: 650px;
}

.coming {
  display: inline-block;
  margin-top: 12px;
  padding: 12px 14px;
  border: 1px solid #292d35;
  border-radius: 10px;
  color: #777e89;
  font-size: 13px;
}

.placeholder {
  padding: 60px;
  border: 1px solid #292d35;
  border-radius: 24px;
  background: #111318;
}

.placeholder p {
  color: #9298a2;
  line-height: 1.7;
  margin-bottom: 28px;
}

.footer {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  padding: 24px 6vw;
  border-top: 1px solid #1d2027;
  color: #666d78;
  font-size: 12px;
}

@media (max-width: 820px) {
  .header {
    align-items: flex-start;
    flex-direction: column;
    padding: 14px 5%;
  }

  .nav { justify-content: flex-start; }

  .nav a { padding: 7px 8px; font-size: 12px; }

  .home {
    grid-template-columns: 1fr;
    padding: 60px 0;
  }

  .home-panel { min-height: 260px; }

  .section-head { display: block; }

  .hero-grid { grid-template-columns: 1fr; }

  .hero-detail {
    align-items: flex-start;
    flex-direction: column;
    padding: 30px;
  }

  .hero-detail h1 { font-size: 44px; }

  .footer { flex-direction: column; }
}